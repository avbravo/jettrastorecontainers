<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.jettra</groupId>
    <artifactId>JettraStoreExampleSE</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>JettraStoreExampleSE</name>
    <description>Proyecto Java SE 25 de referencia para JettraStoreDriver, JettraRules, Java Records, Patrón Repository, Buckets, Índices y Resiliencia Raft</description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mainClass>io.jettra.example.se.JettraStoreExampleSEApp</mainClass>
        <jettra.frameworks.version>1.0.0-SNAPSHOT</jettra.frameworks.version>
        <jettra.store.version>1.0-SNAPSHOT</jettra.store.version>
        <skipTests>false</skipTests>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.jettra</groupId>
                <artifactId>jettraframeworks</artifactId>
                <version>${jettra.frameworks.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.jettra</groupId>
            <artifactId>JettraStoreDriver</artifactId>
            <version>${jettra.store.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jettra</groupId>
            <artifactId>JettraStore</artifactId>
            <version>${jettra.store.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jettra</groupId>
            <artifactId>JettraRules</artifactId>
            <version>${jettra.frameworks.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jettra</groupId>
            <artifactId>JettraTest</artifactId>
            <version>${jettra.frameworks.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>25</release>
                    <compilerArgs>
                        <arg>--enable-preview</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <skipTests>true</skipTests>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <id>default-cli</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <mainClass>${mainClass}</mainClass>
                            <executable>java</executable>
                            <arguments>
                                <argument>-Xms64m</argument>
                                <argument>-Xmx256m</argument>
                                <argument>-XX:MaxMetaspaceSize=192m</argument>
                                <argument>-XX:MaxDirectMemorySize=128m</argument>
                                <argument>-XX:+UseG1GC</argument>
                                <argument>-XX:+UseStringDeduplication</argument>
                                <argument>-XX:CICompilerCount=2</argument>
                                <argument>--enable-preview</argument>
                                <argument>--enable-native-access=ALL-UNNAMED</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>${mainClass}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jettra-test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>java</executable>
                            <classpathScope>test</classpathScope>
                            <skip>${skipTests}</skip>
                            <arguments>
                                <argument>-Xms64m</argument>
                                <argument>-Xmx512m</argument>
                                <argument>-XX:MaxMetaspaceSize=256m</argument>
                                <argument>-XX:MaxDirectMemorySize=256m</argument>
                                <argument>-XX:+UseG1GC</argument>
                                <argument>-XX:CICompilerCount=2</argument>
                                <argument>--enable-preview</argument>
                                <argument>--enable-native-access=ALL-UNNAMED</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>io.jettra.test.runner.JettraTestRunner</argument>
                                <argument>${project.build.testOutputDirectory}</argument>
                                <argument>${project.build.outputDirectory}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
